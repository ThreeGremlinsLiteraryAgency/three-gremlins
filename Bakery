<!-- CART -->

<section class="cart-section">

  <div class="cart-box">

    <h2>
      Your Gremlin Order
    </h2>

    <div id="cartItems">

      <p class="cart-empty">
        Your order is currently suspiciously empty.
      </p>

    </div>

    <div class="cart-total">
      Total: $<span id="cartTotal">0.00</span>
    </div>

    <button
      id="checkoutButton"
      class="checkout-button"
      disabled
    >
      Proceed to Checkout
    </button>

  </div>

</section>


<!-- STORY -->

<section class="story" id="story">

  <div class="story-inner">

    <div>

      <div
        class="eyebrow"
        style="color:#d5c399;"
      >
        Why We Bake
      </div>

      <h2>
        Comfort Food for Real Life.
      </h2>

      <p>
        Three Gremlins Bakery isn't interested in pretending
        everything is perfect.
      </p>

      <p>
        Sometimes life is messy. Sometimes people are exhausted.
        Sometimes the kitchen looks like somebody detonated a flour
        bomb, and occasionally dessert happens because somebody
        desperately needed dessert.
      </p>

      <p>
        We believe food can be warm without being fancy,
        beautiful without being flawless, and meaningful without
        taking itself too seriously.
      </p>

    </div>

    <div class="story-card">
      “We bake.<br>
      You survive.<br>
      Everyone wins.”
    </div>

  </div>

</section>


<!-- VALUES -->

<section class="values">

  <div class="value-card">

    <h3>
      Small Batch
    </h3>

    <p>
      Made in manageable batches instead of disappearing into
      some enormous industrial bakery.
    </p>

  </div>


  <div class="value-card">

    <h3>
      Handmade
    </h3>

    <p>
      Actual people. Actual kitchens. Actual flour that will
      somehow end up on absolutely everything.
    </p>

  </div>


  <div class="value-card">

    <h3>
      Comfort First
    </h3>

    <p>
      Food should taste like somebody wanted you to have
      a better day.
    </p>

  </div>


  <div class="value-card">

    <h3>
      Gremlin Approved
    </h3>

    <p>
      Scientific standards remain questionable, but enthusiasm
      is extremely high.
    </p>

  </div>

</section>


<section class="order-section" id="order">

  <div class="eyebrow">
    Feed Me
  </div>

  <h2>
    Want Some Gremlin Food?
  </h2>

  <p>
    Pick your treats above, choose your quantities,
    and the gremlins will do the math.
  </p>

</section>


<footer>

  <div class="footer-inner">

    <div class="footer-name">
      THREE GREMLINS BAKERY
    </div>

    <div class="footer-links">
      <a href="index.html">Three Gremlins Home</a>
      <a href="#menu">Treats</a>
      <a href="#story">Our Story</a>
      <a href="#">Facebook</a>
      <a href="#">Instagram</a>
    </div>

  </div>

  <div class="footer-bottom">
    © 2026 Three Gremlins Bakery.
    Made with chaos, love, and an irresponsible amount of butter.
  </div>

</footer>


<script>

  /*
    -------------------------------
    THREE GREMLINS SHOPPING CART
    -------------------------------
  */

  const cart = {};

  const cartItemsContainer =
    document.getElementById("cartItems");

  const cartTotalElement =
    document.getElementById("cartTotal");

  const checkoutButton =
    document.getElementById("checkoutButton");


  /*
    ADD PRODUCT
  */

  document
    .querySelectorAll(".product-card")
    .forEach(card => {

      const button =
        card.querySelector(".add-button");

      button.addEventListener("click", () => {

        const id =
          card.dataset.id;

        const name =
          card.dataset.name;

        const price =
          parseFloat(card.dataset.price);

        const quantity =
          parseInt(
            card.querySelector(".quantity-select").value
          );


        /*
          If they add the same product again,
          replace the previous quantity with
          the newly selected quantity.
        */

        cart[id] = {
          id,
          name,
          price,
          quantity
        };


        button.textContent =
          "✓ Added to Order";

        button.classList.add("added");


        setTimeout(() => {

          button.textContent =
            "Update Order";

        }, 1200);


        updateCart();

      });

    });


  /*
    DRAW CART
  */

  function updateCart() {

    const items =
      Object.values(cart);


    if (items.length === 0) {

      cartItemsContainer.innerHTML = `
        <p class="cart-empty">
          Your order is currently suspiciously empty.
        </p>
      `;

      cartTotalElement.textContent =
        "0.00";

      checkoutButton.disabled =
        true;

      return;

    }


    cartItemsContainer.innerHTML =
      "";


    let total = 0;


    items.forEach(item => {

      const itemTotal =
        item.price * item.quantity;

      total += itemTotal;


      const row =
        document.createElement("div");

      row.className =
        "cart-item";


      row.innerHTML = `

        <div>

          <div class="cart-item-name">
            ${item.name}
          </div>

          <div class="cart-item-detail">
            ${item.quantity}
            ×
            $${item.price.toFixed(2)}
          </div>

        </div>


        <strong>
          $${itemTotal.toFixed(2)}
        </strong>


        <button
          class="remove-button"
          data-remove="${item.id}"
        >
          Remove
        </button>

      `;


      cartItemsContainer.appendChild(row);

    });


    cartTotalElement.textContent =
      total.toFixed(2);


    checkoutButton.disabled =
      false;


    /*
      REMOVE BUTTONS
    */

    document
      .querySelectorAll(".remove-button")
      .forEach(button => {

        button.addEventListener("click", () => {

          const id =
            button.dataset.remove;

          delete cart[id];

          updateCart();

        });

      });

  }


  /*
    CHECKOUT

    Converts cart into text that can travel
    to checkout.html through the URL.
  */

  checkoutButton.addEventListener(
    "click",
    () => {

      const items =
        Object.values(cart);


      if (items.length === 0) {
        return;
      }


      const cartData =
        encodeURIComponent(
          JSON.stringify(items)
        );


      window.location.href =
        "checkout.html?cart=" + cartData;

    }
  );

</script>

</body>
</html>
