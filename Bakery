<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>Three Gremlins Bakery</title>

  <style>
    :root {
      --cream: #f5ead8;
      --cream-dark: #e7d3b5;
      --sage: #7d875d;
      --olive: #536039;
      --deep-green: #303824;
      --brown: #4b301d;
      --dark-brown: #271b12;
      --gold: #c19a5b;
      --paper: #efe1c8;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    html {
      scroll-behavior: smooth;
    }

    body {
      background:
        radial-gradient(circle at top, #f3e7d0, #e6d4b5 55%, #d4bb92);
      color: var(--dark-brown);
      font-family: Georgia, "Times New Roman", serif;
      line-height: 1.6;
    }

    a {
      text-decoration: none;
      color: inherit;
    }

    button,
    select {
      font: inherit;
    }

    /* NAVIGATION */

    nav {
      position: sticky;
      top: 0;
      width: 100%;
      z-index: 1000;
      background: rgba(39, 27, 18, 0.96);
      border-bottom: 2px solid var(--gold);
      backdrop-filter: blur(8px);
    }

    .nav-inner {
      max-width: 1200px;
      margin: auto;
      min-height: 70px;
      padding: 12px 24px;

      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 25px;
    }

    .nav-brand {
      color: var(--cream);
      font-size: 1.4rem;
      font-weight: bold;
      letter-spacing: 2px;
    }

    .nav-links {
      display: flex;
      gap: 24px;
      flex-wrap: wrap;
      align-items: center;
    }

    .nav-links a {
      color: var(--cream);
    }

    .nav-links a:hover {
      color: var(--gold);
    }

    .home-link {
      border: 1px solid var(--gold);
      padding: 8px 14px;
      border-radius: 4px;
    }

    /* HERO */

    .hero {
      min-height: 82vh;
      display: grid;
      grid-template-columns: 1fr 1fr;
      align-items: center;

      max-width: 1250px;
      margin: auto;
      padding: 75px 35px;
      gap: 50px;
    }

    .hero-logo {
      display: flex;
      justify-content: center;
      align-items: center;
    }

    .hero-logo img {
      max-width: 100%;
      width: 600px;
      height: auto;
      filter: drop-shadow(0 16px 24px rgba(60, 35, 15, 0.2));
    }

    .hero-copy {
      max-width: 550px;
    }

    .hero-tag {
      color: var(--olive);
      text-transform: uppercase;
      letter-spacing: 4px;
      font-weight: bold;
      margin-bottom: 15px;
    }

    .hero-copy h1 {
      font-size: clamp(2.6rem, 5vw, 5rem);
      line-height: 1;
      margin-bottom: 20px;
      color: var(--brown);
    }

    .hero-copy h1 span {
      color: var(--olive);
    }

    .hero-copy p {
      font-size: 1.15rem;
      margin-bottom: 30px;
      color: #67533f;
    }

    .hero-buttons {
      display: flex;
      gap: 15px;
      flex-wrap: wrap;
    }

    .button {
      background: var(--olive);
      color: white;
      padding: 14px 23px;
      border-radius: 5px;
      font-weight: bold;
      display: inline-block;
      transition: 0.2s ease;
      border: 2px solid var(--olive);
      cursor: pointer;
    }

    .button:hover {
      background: var(--deep-green);
      border-color: var(--deep-green);
      transform: translateY(-2px);
    }

    .button.secondary {
      background: transparent;
      color: var(--brown);
      border-color: var(--brown);
    }

    .button.secondary:hover {
      background: var(--brown);
      color: white;
    }

    /* CHAOS BAR */

    .chaos-bar {
      background: var(--olive);
      color: white;

      display: flex;
      justify-content: center;
      gap: 50px;
      flex-wrap: wrap;

      padding: 19px 30px;

      font-weight: bold;
      letter-spacing: 1px;
    }

    /* GENERAL */

    .eyebrow {
      text-transform: uppercase;
      color: var(--olive);
      letter-spacing: 4px;
      font-size: .85rem;
      font-weight: bold;
      margin-bottom: 10px;
    }

    .welcome {
      max-width: 850px;
      margin: auto;
      padding: 90px 30px;
      text-align: center;
    }

    .welcome h2,
    .products h2,
    .story h2,
    .order-section h2 {
      color: var(--brown);
      font-size: clamp(2.2rem, 5vw, 3.6rem);
      margin-bottom: 20px;
      line-height: 1.1;
    }

    .welcome p {
      color: #6a5541;
      font-size: 1.1rem;
    }

    /* PRODUCTS */

    .products {
      max-width: 1250px;
      margin: auto;
      padding: 20px 30px 70px;
    }

    .product-heading {
      text-align: center;
      margin-bottom: 55px;
    }

    .product-heading p {
      color: #76624d;
      max-width: 700px;
      margin: auto;
    }

    .product-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 28px;
    }

    .product-card {
      background: #f7edda;
      border: 1px solid #cfb78e;
      border-radius: 10px;
      overflow: hidden;

      box-shadow: 0 8px 20px rgba(54, 37, 21, .1);
      transition: .25s ease;
    }

    .product-card:hover {
      transform: translateY(-7px);
      box-shadow: 0 16px 35px rgba(54, 37, 21, .18);
    }

    .product-image {
      height: 290px;

      display: flex;
      justify-content: center;
      align-items: center;

      background: linear-gradient(135deg, #e5d4b8, #f6ead5);

      color: #8f775b;
      text-align: center;

      border-bottom: 1px solid #cfb78e;

      padding: 25px;
      position: relative;
    }

    .product-image::before {
      content: "PRODUCT IMAGE";
      font-weight: bold;
      letter-spacing: 3px;
    }

    .product-image:has(img)::before {
      display: none;
    }

    .product-image img {
      width: 100%;
      height: 100%;
      object-fit: cover;

      position: absolute;
      inset: 0;
    }

    .product-info {
      padding: 24px;
    }

    .product-info h3 {
      color: var(--brown);
      font-size: 1.55rem;
      margin-bottom: 7px;
    }

    .product-description {
      color: #76604a;
      min-height: 95px;
      margin-bottom: 15px;
    }

    .price {
      color: var(--olive);
      font-size: 1.35rem;
      font-weight: bold;
      margin-bottom: 18px;
    }

    .purchase-controls {
      padding-top: 15px;
      border-top: 1px solid #d6c19d;
    }

    .quantity-row {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 15px;
      margin-bottom: 14px;
    }

    .quantity-row label {
      font-weight: bold;
      color: var(--brown);
    }

    .quantity-select {
      padding: 9px 14px;
      background: white;
      border: 1px solid #aa916c;
      border-radius: 5px;
      color: var(--brown);
      min-width: 75px;
      cursor: pointer;
    }

    .add-button {
      width: 100%;
      padding: 12px;

      border: none;
      border-radius: 5px;

      background: var(--olive);
      color: white;

      font-weight: bold;
      cursor: pointer;

      transition: .2s;
    }

    .add-button:hover {
      background: var(--deep-green);
    }

    .add-button.added {
      background: var(--brown);
    }

    /* CART */

    .cart-section {
      max-width: 900px;
      margin: 0 auto 100px;
      padding: 0 30px;
    }

    .cart-box {
      background: var(--dark-brown);
      color: var(--cream);

      padding: 35px;

      border-radius: 10px;
      border: 2px solid var(--gold);

      box-shadow: 0 15px 35px rgba(38, 24, 14, .2);
    }

    .cart-box h2 {
      color: var(--gold);
      margin-bottom: 18px;
    }

    .cart-empty {
      color: #cbbda8;
    }

    .cart-item {
      display: grid;
      grid-template-columns: 1fr auto auto;
      align-items: center;
      gap: 20px;

      border-bottom: 1px solid rgba(255,255,255,.15);

      padding: 14px 0;
    }

    .cart-item-name {
      font-weight: bold;
    }

    .cart-item-detail {
      color: #cfbea5;
    }

    .remove-button {
      border: none;
      background: transparent;
      color: #e6c88d;

      cursor: pointer;
      text-decoration: underline;
    }

    .cart-total {
      font-size: 1.5rem;
      font-weight: bold;
      color: var(--gold);

      text-align: right;

      margin: 25px 0;
    }

    .checkout-button {
      width: 100%;

      padding: 16px;

      background: var(--gold);
      color: var(--dark-brown);

      border: none;
      border-radius: 5px;

      font-size: 1.15rem;
      font-weight: bold;

      cursor: pointer;
    }

    .checkout-button:hover {
      background: #d4b378;
    }

    .checkout-button:disabled {
      opacity: .4;
      cursor: not-allowed;
    }

    /* STORY */

    .story {
      background:
        linear-gradient(
          rgba(48, 56, 36, .96),
          rgba(39, 45, 29, .96)
        );

      color: white;
      padding: 100px 30px;
    }

    .story-inner {
      max-width: 1100px;
      margin: auto;

      display: grid;
      grid-template-columns: 1fr 1fr;

      gap: 70px;
      align-items: center;
    }

    .story h2 {
      color: var(--cream);
    }

    .story p {
      color: #e6dcc8;
      margin-bottom: 18px;
      font-size: 1.08rem;
    }

    .story-card {
      background: rgba(255,255,255,.07);
      border: 1px solid rgba(255,255,255,.15);

      padding: 38px;
      border-radius: 9px;

      font-size: 1.3rem;
      font-style: italic;
      color: var(--cream);
    }

    /* VALUES */

    .values {
      max-width: 1100px;
      margin: auto;
      padding: 100px 30px;

      display: grid;
      grid-template-columns: repeat(4, 1fr);

      gap: 20px;
    }

    .value-card {
      border-top: 3px solid var(--olive);
      padding: 25px;
      background: rgba(255,255,255,.25);
    }

    .value-card h3 {
      color: var(--brown);
      margin-bottom: 8px;
    }

    .value-card p {
      color: #725e49;
      font-size: .95rem;
    }

    /* ORDER */

    .order-section {
      max-width: 900px;
      margin: auto;
      padding: 20px 30px 100px;
      text-align: center;
    }

    .order-section p {
      color: #715d49;
      max-width: 700px;
      margin: auto;
    }

    /* FOOTER */

    footer {
      background: var(--dark-brown);
      color: var(--cream);
      padding: 55px 30px;
    }

    .footer-inner {
      max-width: 1100px;
      margin: auto;

      display: flex;
      justify-content: space-between;
      align-items: center;

      gap: 30px;
      flex-wrap: wrap;
    }

    .footer-name {
      font-size: 1.5rem;
      color: var(--gold);
      font-weight: bold;
    }

    .footer-links {
      display: flex;
      flex-wrap: wrap;
      gap: 20px;
    }

    .footer-links a:hover {
      color: var(--gold);
    }

    .footer-bottom {
      max-width: 1100px;
      margin: 35px auto 0;

      padding-top: 25px;

      border-top: 1px solid rgba(255,255,255,.15);

      color: #ae9e88;
      font-size: .9rem;
    }

    /* MOBILE */

    @media (max-width: 900px) {
      .hero {
        grid-template-columns: 1fr;
        text-align: center;
      }

      .hero-copy {
        margin: auto;
      }

      .hero-buttons {
        justify-content: center;
      }

      .product-grid {
        grid-template-columns: repeat(2, 1fr);
      }

      .story-inner {
        grid-template-columns: 1fr;
      }

      .values {
        grid-template-columns: repeat(2, 1fr);
      }
    }

    @media (max-width: 600px) {
      .nav-inner {
        flex-direction: column;
      }

      .nav-links {
        justify-content: center;
        gap: 13px;
        font-size: .9rem;
      }

      .hero {
        padding-top: 45px;
      }

      .hero-logo img {
        width: 420px;
      }

      .product-grid {
        grid-template-columns: 1fr;
      }

      .values {
        grid-template-columns: 1fr;
      }

      .chaos-bar {
        flex-direction: column;
        gap: 5px;
        text-align: center;
      }

      .cart-item {
        grid-template-columns: 1fr;
        gap: 5px;
      }
    }
  </style>
</head>

